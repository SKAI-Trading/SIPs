{
  "name": "@skai/sips",
  "version": "0.1.0",
  "private": true,
  "description": "SKAI Improvement Proposals, and the checker that keeps them in shape",
  "license": "CC0-1.0",
  "type": "module",
  "exports": {
    ".": { "types": "./tools/index.d.ts", "default": "./tools/index.mjs" },
    "./testing": { "types": "./tools/testing.d.ts", "default": "./tools/testing.mjs" }
  },
  "scripts": {
