    "check": "node tools/check-sips.mjs",
    "check:tree": "node tools/check-sips.mjs --tree-only"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
